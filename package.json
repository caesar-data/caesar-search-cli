{
  "name": "caesar-search-cli",
  "version": "0.1.0",
  "description": "CLI for the Caesar search API — web search with provenance, built for agents and scripts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caesar-data/caesar-search-cli.git"
  },
  "homepage": "https://github.com/caesar-data/caesar-search-cli#readme",
  "bugs": "https://github.com/caesar-data/caesar-search-cli/issues",
  "keywords": [
    "search",
    "cli",
    "agents",
    "web-search",
    "caesar"
  ],
  "type": "module",
  "bin": {
    "caesar-search": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/index.ts --target node --outfile dist/index.js && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "generate:types": "openapi-typescript spec/openapi-public.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3"
  }
}
